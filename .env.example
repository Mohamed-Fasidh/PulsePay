# Copy to .env for local Docker development. Never use production secrets here.
POSTGRES_DB=pulsepay
POSTGRES_USER=pulsepay
POSTGRES_PASSWORD=pulsepay_dev_only
JWT_SECRET=replace-with-a-minimum-32-character-development-secret
WEBHOOK_ENCRYPTION_KEY=replace-with-a-production-managed-secret
PULSEPAY_OUTBOX_MAX_ATTEMPTS=8
PULSEPAY_WEBHOOK_MAX_ATTEMPTS=6
GRAFANA_ADMIN_PASSWORD=admin_dev_only

